---
import type { Locale } from '../i18n/config';
import { siteConfig, getLocalizedPath, localeNames, getAlternateLocale, getContactAnchor } from '../i18n/config';
import { getTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
  currentPath?: string;
}

const { locale, currentPath = '/' } = Astro.props;
const t = getTranslations(locale);
const altLocale = getAlternateLocale(locale);

const navLinks = [
  { href: '#features', label: t.nav.features },
  { href: '#how-it-works', label: t.nav.howItWorks },
  { href: '#channels', label: t.nav.channels },
  { href: '#plans', label: t.nav.plans },
  { href: '#faq', label: t.nav.faq },
  { href: getContactAnchor(locale), label: t.nav.contact },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-stone-200/40 bg-white/70 backdrop-blur-xl dark:border-stone-800/40 dark:bg-stone-950/70">
  <div class="section-shell-wide flex items-center justify-between gap-4 py-4 md:py-5">
    <a href={getLocalizedPath('/', locale)} class="flex items-center gap-3 text-xl font-extrabold tracking-tight md:text-2xl">
      <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-600 text-base font-extrabold text-white md:h-11 md:w-11">R</span>
      <span>Rently<span class="text-brand-600">.pro</span></span>
    </a>

    <nav class="hidden items-center gap-1 xl:flex" aria-label="Main">
      {navLinks.map((link) => (
        <a href={link.href} class="rounded-full px-4 py-2.5 text-sm font-semibold text-stone-600 transition hover:bg-stone-100 hover:text-stone-900 dark:text-stone-400 dark:hover:bg-stone-800 dark:hover:text-white">
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2 md:gap-3">
      <button type="button" data-theme-toggle class="flex h-11 w-11 items-center justify-center rounded-full border border-stone-200 bg-white text-stone-600 transition hover:border-brand-300 dark:border-stone-700 dark:bg-stone-900 dark:text-stone-300" aria-label="Toggle theme">
        <svg data-theme-icon="sun" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        <svg data-theme-icon="moon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
      </button>

      <a href={getLocalizedPath(currentPath, altLocale)} class="hidden h-11 items-center justify-center rounded-full border border-stone-200 px-4 text-sm font-semibold text-stone-600 transition hover:border-brand-300 sm:flex dark:border-stone-700 dark:text-stone-300" hreflang={altLocale}>
        {localeNames[altLocale]}
      </a>

      <a href={siteConfig.userjotUrl} target="_blank" rel="noopener noreferrer" class="btn-primary hidden px-6 py-3 text-sm sm:inline-flex">
        {t.nav.requestFeature}
      </a>
    </div>
  </div>
</header>
