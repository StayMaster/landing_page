---
import type { Locale } from '../i18n/config';
import { getLocalizedPath, getContactAnchor } from '../i18n/config';
import { getTranslations } from '../i18n/translations';
import { pricingTiers } from '../lib/pricing';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const tierLabels = {
  en: {
    starter: '1–3 properties',
    growth: '4–10 properties',
    scale: '11–30 properties',
    enterprise: '31+ properties',
  },
  ar: {
    starter: '1–3 عقارات',
    growth: '4–10 عقارات',
    scale: '11–30 عقاراً',
    enterprise: '31+ عقار',
  },
};
---

<section class="section-pad relative overflow-hidden bg-stone-100/60 dark:bg-stone-900/40" id="plans">
  <div class="section-shell-wide">
    <div class="max-w-5xl animate-on-scroll">
      <span class="section-label">{t.pricing.label}</span>
      <h2 class="section-title mt-4">{t.pricing.title}</h2>
      <p class="section-subtitle">{t.pricing.subtitle}</p>
      <p class="mt-4 text-lg text-amber-700 dark:text-amber-400">{t.pricing.note}</p>
    </div>

    <div class="card animate-on-scroll mx-auto mt-14 max-w-4xl rounded-[2rem] p-8 md:p-12">
      <label for="property-slider" class="block text-base font-bold text-stone-700 dark:text-stone-300">
        {t.pricing.sliderLabel}
      </label>
      <div class="mt-4 flex items-center gap-4">
        <input
          id="property-slider"
          type="range"
          min="1"
          max="40"
          value="2"
          class="h-2 w-full cursor-pointer appearance-none rounded-full bg-stone-200 accent-brand-600 dark:bg-stone-700"
        />
        <output id="property-count" class="min-w-[3rem] text-center text-2xl font-extrabold text-brand-600">2</output>
      </div>
      <p id="property-tier-label" class="mt-2 text-center text-sm text-stone-500 dark:text-stone-400">
        {tierLabels[locale].starter}
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-3">
      <!-- Free Trial -->
      <div class="card-hover animate-on-scroll p-8 md:p-10">
        <h3 class="text-2xl font-extrabold">{t.pricing.trial.name}</h3>
        <p class="mt-3 text-base text-stone-600 dark:text-stone-400">{t.pricing.trial.tagline}</p>
        <div class="mt-8">
          <span class="text-5xl font-extrabold text-brand-600">{t.pricing.trial.price}</span>
          <span class="ms-1 text-stone-500">{t.pricing.trial.tagline.includes('month') || t.pricing.trial.tagline.includes('شهر') ? '' : t.pricing.perMonth}</span>
        </div>
        <ul class="mt-8 space-y-3">
          {t.pricing.trial.features.map((f) => (
            <li class="flex items-start gap-2 text-sm text-stone-600 dark:text-stone-400">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              {f}
            </li>
          ))}
        </ul>
      </div>

      <!-- Basic -->
      <div class="card-hover animate-on-scroll delay-100 p-8 md:p-10">
        <h3 class="text-2xl font-extrabold">{t.pricing.basic.name}</h3>
        <p class="mt-3 text-base text-stone-600 dark:text-stone-400">{t.pricing.basic.tagline}</p>
        <div class="mt-8" id="basic-price-wrap">
          <span class="text-5xl font-extrabold text-brand-600" id="basic-price">99</span>
          <span class="ms-1 text-stone-500">{t.pricing.currency} {t.pricing.perMonth}</span>
        </div>
        <p class="mt-1 hidden text-lg font-semibold text-stone-600 dark:text-stone-400" id="basic-quote">{t.pricing.getQuote}</p>
        <ul class="mt-8 space-y-3">
          {t.pricing.basic.features.map((f) => (
            <li class="flex items-start gap-2 text-sm text-stone-600 dark:text-stone-400">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              {f}
            </li>
          ))}
        </ul>
      </div>

      <!-- Pro -->
      <div class="card-hover animate-on-scroll delay-200 relative p-8 md:p-10 ring-2 ring-brand-500/40">
        <span class="absolute -top-3 start-6 rounded-full bg-brand-600 px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-white">{t.pricing.pro.popular}</span>
        <h3 class="text-2xl font-extrabold">{t.pricing.pro.name}</h3>
        <p class="mt-3 text-base text-stone-600 dark:text-stone-400">{t.pricing.pro.tagline}</p>
        <div class="mt-8" id="pro-price-wrap">
          <span class="text-5xl font-extrabold text-brand-600" id="pro-price">299</span>
          <span class="ms-1 text-stone-500">{t.pricing.currency} {t.pricing.perMonth}</span>
        </div>
        <p class="mt-1 hidden text-lg font-semibold text-stone-600 dark:text-stone-400" id="pro-quote">{t.pricing.getQuote}</p>
        <ul class="mt-8 space-y-3">
          {t.pricing.pro.features.map((f) => (
            <li class="flex items-start gap-2 text-sm text-stone-600 dark:text-stone-400">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              {f}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-10 text-center">
      <a href={`${getContactAnchor(locale)}?subject=waitlist`} class="btn-primary">{t.pricing.cta}</a>
    </div>
  </div>
</section>

<script define:vars={{ pricingTiers, tierLabels, locale, getQuoteLabel: t.pricing.getQuote }}>
  const slider = document.getElementById('property-slider');
  const countOut = document.getElementById('property-count');
  const tierLabel = document.getElementById('property-tier-label');
  const basicPrice = document.getElementById('basic-price');
  const proPrice = document.getElementById('pro-price');
  const basicWrap = document.getElementById('basic-price-wrap');
  const proWrap = document.getElementById('pro-price-wrap');
  const basicQuote = document.getElementById('basic-quote');
  const proQuote = document.getElementById('pro-quote');

  const labels = tierLabels[locale];

  function updatePricing(count) {
    const n = Number(count);
    countOut.textContent = n >= 31 ? '31+' : String(n);

    let tier = pricingTiers[0];
    if (n >= 31) tier = pricingTiers[3];
    else if (n >= 11) tier = pricingTiers[2];
    else if (n >= 4) tier = pricingTiers[1];

    tierLabel.textContent = labels[tier.id];

    const isQuote = tier.id === 'enterprise';

    basicWrap?.classList.toggle('hidden', isQuote);
    proWrap?.classList.toggle('hidden', isQuote);
    basicQuote?.classList.toggle('hidden', !isQuote);
    proQuote?.classList.toggle('hidden', !isQuote);

    if (!isQuote && basicPrice && proPrice) {
      basicPrice.textContent = String(tier.basicPrice);
      proPrice.textContent = String(tier.proPrice);
    }

    if (typeof window.posthog !== 'undefined') {
      window.posthog.capture('pricing_slider_changed', {
        property_count: n,
        tier: tier.id,
      });
    }
  }

  slider?.addEventListener('input', (e) => updatePricing(e.target.value));
  updatePricing(slider?.value ?? 2);
</script>
