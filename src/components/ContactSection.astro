---
import type { Locale } from '../i18n/config';
import { getTranslations } from '../i18n/translations';
import ContactForm from './ContactForm.astro';
import type { ContactSubjectId } from '../lib/contact-subjects';
import BlobBackground from './BlobBackground.astro';

interface Props {
  locale: Locale;
  success?: boolean;
  defaultSubject?: ContactSubjectId;
  returnPath?: string;
  returnHash?: string;
  formId?: string;
  showHeader?: boolean;
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  locale,
  success = false,
  defaultSubject = 'waitlist',
  returnPath = '/',
  returnHash = '#contact',
  formId = 'section',
  showHeader = true,
  title,
  subtitle,
  class: className = '',
} = Astro.props;

const t = getTranslations(locale);
const heading = title ?? t.contact.sectionTitle;
const subheading = subtitle ?? t.contact.sectionSubtitle;
---

<section class={`section-pad relative overflow-hidden ${className}`} id="contact">
  <BlobBackground seed="contact" />
  <div class="section-shell-wide">
    <div class="grid gap-12 xl:grid-cols-12 xl:gap-16">
      {showHeader && (
        <div class="animate-on-scroll xl:col-span-5 xl:sticky xl:top-32 xl:self-start">
          <span class="section-label">{t.contact.sectionLabel}</span>
          <h2 class="display-title mt-4">{heading}</h2>
          <p class="section-subtitle">{subheading}</p>
        </div>
      )}
      <div class={`animate-on-scroll delay-100 ${showHeader ? 'xl:col-span-7' : 'xl:col-span-10 xl:col-start-2'}`}>
        <ContactForm
          locale={locale}
          success={success}
          defaultSubject={defaultSubject}
          returnPath={returnPath}
          returnHash={returnHash}
          formId={formId}
        />
      </div>
    </div>
  </div>
</section>
