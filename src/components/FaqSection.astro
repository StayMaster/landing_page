---
import type { Locale } from '../i18n/config';
import { getTranslations } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="section-pad relative overflow-hidden bg-stone-100/50 dark:bg-stone-900/30" id="faq">
  <div class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-brand-600/5 via-transparent to-brand-600/10 dark:from-brand-900/20"></div>

  <div class="section-shell-wide">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16 xl:gap-24">
      <div class="animate-on-scroll lg:col-span-5 lg:sticky lg:top-32 lg:self-start">
        <span class="section-label">{t.faq.label}</span>
        <h2 class="display-title mt-4">
          {t.faq.title}
        </h2>
        <p class="mt-6 text-xl text-stone-600 md:text-2xl dark:text-stone-400">{t.faq.subtitle}</p>
      </div>

      <div class="animate-on-scroll delay-100 lg:col-span-7">
        <div class="divide-y divide-stone-200 rounded-[2rem] border border-stone-200 bg-white/80 px-6 backdrop-blur-sm dark:divide-stone-800 dark:border-stone-800 dark:bg-stone-900/80 md:px-10">
          {t.faq.items.map((item, i) => (
            <details class="faq-item group py-7 md:py-8">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 [&::-webkit-details-marker]:hidden">
                <span class="flex items-start gap-5">
                  <span class="mt-1 font-mono text-sm font-bold text-brand-600 dark:text-brand-400">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-xl font-bold leading-snug text-stone-900 md:text-2xl dark:text-white">
                    {item.question}
                  </span>
                </span>
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-stone-200 text-2xl font-light text-brand-600 transition group-open:rotate-45 group-open:border-brand-500 dark:border-stone-700">
                  +
                </span>
              </summary>
              <p class="ms-14 mt-5 pe-4 text-lg leading-relaxed text-stone-600 dark:text-stone-400">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-item').forEach((item) => {
    item.addEventListener('toggle', () => {
      if (!(item instanceof HTMLDetailsElement) || !item.open) return;
      document.querySelectorAll('.faq-item[open]').forEach((other) => {
        if (other !== item) other.removeAttribute('open');
      });
    });
  });
</script>
