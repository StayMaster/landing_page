---
import { getBlobConfigs } from '../lib/section-effects';

interface Props {
  seed?: string;
}

const { seed = 'default' } = Astro.props;
const blobs = getBlobConfigs(seed, 3);
---

<div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
  {blobs.map((blob, i) => (
    <div
      class={`blob absolute rounded-full blur-3xl ${blob.colorClass}`}
      style={`top: ${blob.top}; left: ${blob.left}; width: min(${blob.size}, 80vw); height: min(${blob.size}, 80vw); animation-delay: ${blob.delay};`}
    />
  ))}
</div>
