---
import type { Locale } from '../i18n/config';
import { siteConfig, getContactAnchor } from '../i18n/config';
import { getTranslations } from '../i18n/translations';
import BlobBackground from './BlobBackground.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="relative min-h-[92vh] overflow-hidden pt-28 md:pt-32">
  <BlobBackground />

  <div class="section-shell-wide">
    <div class="grid min-h-[calc(92vh-8rem)] items-center gap-12 lg:grid-cols-12 lg:gap-8">
      <div class="animate-on-scroll lg:col-span-6 xl:col-span-5">
        <span class="section-label">{t.hero.badge}</span>
        <h1 class="hero-title mt-6">
          {t.hero.title}
          <span class="bg-gradient-to-r from-brand-600 via-emerald-500 to-teal-400 bg-clip-text text-transparent">
            {t.hero.titleHighlight}
          </span>
        </h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-stone-600 md:text-2xl dark:text-stone-400">
          {t.hero.subtitle}
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href={getContactAnchor(locale)} class="btn-primary">
            {t.hero.ctaPrimary}
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a href="#how-it-works" class="btn-secondary">{t.hero.ctaSecondary}</a>
        </div>
      </div>

      <div class="animate-on-scroll delay-200 lg:col-span-6 xl:col-span-7">
        <div class="relative overflow-hidden rounded-[2.5rem] shadow-2xl shadow-brand-600/20 ring-1 ring-stone-200/50 dark:ring-stone-700/50">
          <div class="relative aspect-[16/10] overflow-hidden bg-stone-900 md:aspect-[16/9]">
            <video
              class="h-full w-full object-cover"
              autoplay
              muted
              loop
              playsinline
              poster="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=1600&h=900&fit=crop"
            >
              <source src="https://cdn.coverr.co/videos/coverr-luxury-villa-with-swimming-pool-9885/1080p.mp4" type="video/mp4" />
            </video>
            <div class="absolute inset-0 bg-gradient-to-t from-stone-950/70 via-transparent to-transparent"></div>
            <div class="absolute bottom-6 start-6 end-6">
              <span class="rounded-full bg-white/15 px-4 py-2 text-sm font-medium text-white backdrop-blur-md">{t.hero.videoCaption}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="border-y border-stone-200/80 bg-gradient-to-r from-brand-50/80 via-white to-emerald-50/80 py-10 dark:border-stone-800 dark:from-brand-950/40 dark:via-stone-950 dark:to-emerald-950/30">
  <div class="section-shell-wide">
    <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6">
      {t.trust.map((item, i) => (
        <span class={`animate-on-scroll delay-${(i + 1) * 100} rounded-full border border-brand-200/80 bg-white/80 px-6 py-3 text-base font-bold text-brand-800 shadow-sm dark:border-brand-800 dark:bg-stone-900/80 dark:text-brand-200`}>
          {item.label}
        </span>
      ))}
    </div>
  </div>
</section>

<section class="section-pad relative overflow-hidden">
  <BlobBackground />
  <div class="section-shell-wide">
    <div class="overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-stone-900 to-stone-800 shadow-2xl dark:from-stone-950 dark:to-stone-900 lg:grid lg:grid-cols-2">
      <div class="relative min-h-[320px] lg:min-h-[480px]">
        <img
          src="https://images.unsplash.com/photo-1613490493576-7fde63acd811?w=1200&h=800&fit=crop"
          alt="Luxury chalet in Saudi Arabia"
          class="absolute inset-0 h-full w-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-stone-950/50 to-transparent lg:bg-gradient-to-l"></div>
      </div>
      <div class="flex flex-col justify-center p-10 md:p-14 lg:p-20">
        <p class="animate-on-scroll text-3xl font-bold leading-snug text-white md:text-4xl lg:text-5xl">
          "{t.hero.quote}"
        </p>
        <p class="animate-on-scroll delay-100 mt-8 text-xl text-stone-300 md:text-2xl">
          {t.hero.quoteSub}
        </p>
      </div>
    </div>
  </div>
</section>
