---
import type { Locale } from '../i18n/config';
import { getTranslations } from '../i18n/translations';
import { otaLogos } from '../lib/pricing';
import OtaLogo from './OtaLogo.astro';
import BlobBackground from './BlobBackground.astro';
import SectionGlow from './SectionGlow.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const liveOtAs = otaLogos.filter((o) => o.live);
const soonOtAs = otaLogos.filter((o) => !o.live);

function getDescription(name: string, live: boolean) {
  const list = live ? t.channels.live : t.channels.comingSoon;
  return list.find((c) => c.name === name)?.description ?? '';
}

const audienceImages = [
  'https://images.unsplash.com/photo-1564013799919-ab600027ffc6?w=800&h=600&fit=crop',
  'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800&h=600&fit=crop',
  'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=800&h=600&fit=crop',
  'https://images.unsplash.com/photo-1600566753190-17f0baa2a6a3?w=800&h=600&fit=crop',
];
---

<section class="audience-section relative overflow-hidden bg-stone-950 text-white" id="audience" data-audience-section>
  <SectionGlow seed="audience" count={3} />
  <div class="audience-sticky">
    <div class="audience-rail" role="region" aria-label={t.audience.title} tabindex="0" data-audience-rail>
      <article class="audience-rail-intro">
        <span class="section-label text-brand-400">{t.audience.label}</span>
        <h2 class="audience-rail-heading mt-4">{t.audience.title}</h2>
        <p class="audience-rail-sub mt-6">{t.audience.subtitle}</p>
        <p class="audience-rail-hint mt-8" aria-hidden="true">
          {t.audience.swipeHint}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </p>
      </article>

      {t.audience.items.map((item, i) => (
        <article class="audience-rail-card" data-audience-card>
          <div class="audience-rail-text">
            <span class="audience-rail-num">
              {String(i + 1).padStart(2, '0')}
              <span class="audience-rail-num-total">/ {String(t.audience.items.length).padStart(2, '0')}</span>
            </span>
            <h3 class="audience-rail-title">{item.title}</h3>
            <p class="audience-rail-desc">{item.description}</p>
          </div>
          <div class="audience-rail-mockup-wrap">
            <div class="audience-rail-mockup">
              <img src={audienceImages[i]} alt="" class="audience-rail-mockup-img" loading="lazy" />
              <div class="audience-rail-mockup-fade"></div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section-pad relative overflow-hidden bg-gradient-to-b from-stone-100 to-white dark:from-stone-900/60 dark:to-stone-950" id="problem">
  <SectionGlow seed="problem" />
  <div class="section-shell-wide">
    <div class="max-w-4xl animate-on-scroll">
      <span class="section-label">{t.problem.label}</span>
      <h2 class="section-title mt-4">{t.problem.title}</h2>
      <p class="section-subtitle">{t.problem.subtitle}</p>
    </div>
    <div class="mt-16 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {t.problem.items.map((item, i) => (
        <div class={`card-hover animate-on-scroll delay-${(i + 1) * 100}`}>
          <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-red-100 text-red-600 dark:bg-red-950 dark:text-red-400">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          </div>
          <h3 class="text-xl font-bold md:text-2xl dark:text-white">{item.title}</h3>
          <p class="mt-3 text-lg text-stone-600 dark:text-stone-400">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-pad relative overflow-hidden" id="how-it-works">
  <BlobBackground seed="how-it-works" />
  <SectionGlow seed="how-it-works" />
  <div class="section-shell-wide">
    <div class="max-w-4xl animate-on-scroll">
      <span class="section-label">{t.howItWorks.label}</span>
      <h2 class="section-title mt-4">{t.howItWorks.title}</h2>
      <p class="section-subtitle">{t.howItWorks.subtitle}</p>
    </div>
    <div class="mt-16 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {t.howItWorks.steps.map((step, i) => (
        <div class={`card-hover animate-on-scroll delay-${(i + 1) * 100}`}>
          <div class="mb-6 font-mono text-4xl font-extrabold text-brand-600/30">{String(i + 1).padStart(2, '0')}</div>
          <h3 class="text-xl font-bold md:text-2xl dark:text-white">{step.title}</h3>
          <p class="mt-3 text-lg text-stone-600 dark:text-stone-400">{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-pad relative overflow-hidden bg-stone-950 text-white" id="features">
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand-600/20 via-transparent to-emerald-600/10"></div>
  <div class="section-shell-wide relative">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="animate-on-scroll max-w-4xl">
        <span class="section-label text-brand-400">{t.features.label}</span>
        <h2 class="display-title mt-4 text-white">{t.features.title}</h2>
        <p class="mt-6 text-xl text-stone-400 md:text-2xl">{t.features.subtitle}</p>
      </div>
      <p class="text-sm font-semibold uppercase tracking-wider text-stone-500">{t.audience.swipeHint}</p>
    </div>

    <div class="scroll-row mt-12 -mx-4 px-4 sm:-mx-8 sm:px-8">
      {t.features.items.map((item, i) => (
        <div class={`scroll-card-feature animate-on-scroll delay-${(i % 3 + 1) * 100} rounded-[2rem] border border-stone-800 bg-stone-900/80 p-8 backdrop-blur-sm md:p-10`}>
          <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-600/20 text-brand-400">
            <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              {item.icon === 'layout-dashboard' && <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h4a1 1 0 011 1v5a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v2a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 12a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1v-7z"/>}
              {item.icon === 'message-circle' && <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>}
              {item.icon === 'refresh-cw' && <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>}
              {item.icon === 'bar-chart' && <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>}
              {item.icon === 'wallet' && <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>}
              {item.icon === 'shield' && <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>}
            </svg>
          </div>
          <h3 class="text-2xl font-bold">{item.title}</h3>
          <p class="mt-4 text-lg leading-relaxed text-stone-400">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-pad relative overflow-hidden" id="channels">
  <div class="section-shell-wide">
    <div class="max-w-4xl animate-on-scroll">
      <span class="section-label">{t.channels.label}</span>
      <h2 class="section-title mt-4">{t.channels.title}</h2>
      <p class="section-subtitle">{t.channels.subtitle}</p>
    </div>

    <p class="animate-on-scroll mt-16 text-sm font-bold uppercase tracking-[0.2em] text-brand-600">{t.channels.liveLabel}</p>
    <div class="scroll-row mt-8 -mx-4 px-4 sm:-mx-8 sm:px-8">
      {liveOtAs.map((ota, i) => (
        <div class={`scroll-card min-w-[85vw] sm:min-w-[400px] card-hover animate-on-scroll delay-${(i + 1) * 100} ring-2 ring-brand-500/30`}>
          <OtaLogo slug={ota.slug} name={ota.name} live={true} class="mb-6 h-16" />
          <p class="text-lg text-stone-600 dark:text-stone-400">{getDescription(ota.name, true)}</p>
        </div>
      ))}
    </div>

    <p class="animate-on-scroll mt-16 text-sm font-bold uppercase tracking-[0.2em] text-stone-500">{t.channels.comingSoonLabel}</p>
    <div class="scroll-row mt-8 -mx-4 px-4 sm:-mx-8 sm:px-8">
      {soonOtAs.map((ota, i) => (
        <div class={`scroll-card min-w-[70vw] sm:min-w-[280px] card animate-on-scroll delay-${(i + 1) * 100} opacity-90`}>
          <OtaLogo slug={ota.slug} name={ota.name} live={false} comingSoonLabel={t.channels.comingSoonLabel} class="mb-4 h-14" />
          <p class="text-base text-stone-600 dark:text-stone-400">{getDescription(ota.name, false)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section-pad relative overflow-hidden bg-gradient-to-br from-brand-50/50 via-white to-emerald-50/30 dark:from-stone-900 dark:via-stone-950 dark:to-brand-950/20" id="platforms">
  <BlobBackground seed="platforms" />
  <SectionGlow seed="platforms" count={2} />
  <div class="section-shell-wide">
    <div class="grid items-center gap-12 xl:grid-cols-2 xl:gap-20">
      <div>
        <span class="section-label animate-on-scroll">{t.platforms.label}</span>
        <h2 class="section-title animate-on-scroll delay-100 mt-4">{t.platforms.title}</h2>
        <p class="section-subtitle animate-on-scroll delay-200">{t.platforms.subtitle}</p>
        <div class="mt-12 grid gap-5 sm:grid-cols-2">
          {t.platforms.items.map((item, i) => (
            <div class={`card animate-on-scroll delay-${(i % 2 + 1) * 100}`}>
              <h3 class="text-lg font-bold md:text-xl dark:text-white">{item.title}</h3>
              <p class="mt-2 text-base text-stone-600 dark:text-stone-400">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="animate-on-scroll delay-200">
        <div class="overflow-hidden rounded-[2.5rem] shadow-2xl ring-1 ring-stone-200/50 dark:ring-stone-800">
          <img src="https://images.unsplash.com/photo-1551434678-e076c223a692?w=1200&h=800&fit=crop" alt="Dashboard preview" class="w-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>
